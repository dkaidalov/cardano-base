data-files:
  bls12-381-test-vectors/test_vectors/bls_sig_aug_test_vectors
  bls12-381-test-vectors/test_vectors/ec_operations_test_vectors
  bls12-381-test-vectors/test_vectors/h2c_large_dst
  bls12-381-test-vectors/test_vectors/pairing_test_vectors
  bls12-381-test-vectors/test_vectors/serde_test_vectors

flag secp256k1-support
  description:
    Enable support for functions from libsecp256k1. Requires
    a recent libsecp256k1 with support for Schnorr signatures.

  default: True
  manual: True

flag pq-native-backends
  description:
    Build the vendored post-quantum signature sources with their optimised
    backends instead of portable C: mldsa-native's assembly backends
    (AVX2 on x86_64), PQClean's AVX2 Falcon (hardware floating point
    instead of the portable build's integer emulation), the SPHINCS+
    8-way AVX2 SHA-256 variant, and for the XMSS reference SHA-NI SHA-256
    (chosen at run time) plus cached PRF midstates. Requires a CPU with
    AVX2, BMI2 and FMA on x86_64. Note that the -m flags apply to
    every C source of the library.

  default: False
  manual: True

flag stateful-mock-tests
  description:
    Run the test groups of the benchmark-only stateful leaf XmssMockDSIGN.
    Off by default: every case generates a 2^10-leaf XMSS tree (about a
    second), and the groups take about a quarter of an hour.

  default: False
  manual: True

common base
  build-depends: base >=4.18 && <5

common project-config
  default-language: Haskell2010
  ghc-options:
    -Wall
    -Wcompat
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wunused-packages

  -- ghc-9.14 gives redundant constraint warnings on some constraints
  -- that are needed for earlier compilers.
  if impl(ghc <9.14)
    ghc-options:
      -Wredundant-constraints

