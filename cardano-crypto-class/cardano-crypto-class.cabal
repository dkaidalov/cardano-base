  import: base, project-config
  hs-source-dirs: src
  exposed-modules:
    Cardano.Crypto.DSIGN
    Cardano.Crypto.DSIGN.BLS12381
    Cardano.Crypto.DSIGN.BLS12381.Internal
    Cardano.Crypto.DSIGN.Class
    Cardano.Crypto.DSIGN.Ed25519
    Cardano.Crypto.DSIGN.Ed448
    Cardano.Crypto.DSIGN.Falcon512
    Cardano.Crypto.DSIGN.MLDSA44
    Cardano.Crypto.DSIGN.Mock
    Cardano.Crypto.DSIGN.NeverUsed
    Cardano.Crypto.DSIGN.SlhDsaBb6
    Cardano.Crypto.DSIGN.XmssMock
    Cardano.Crypto.DirectSerialise
    Cardano.Crypto.EllipticCurve.BLS12_381
    Cardano.Crypto.EllipticCurve.BLS12_381.Internal
    Cardano.Crypto.Falcon.C
    Cardano.Crypto.Falcon.Constants
    Cardano.Crypto.Hash
    Cardano.Crypto.Hash.Blake2b
    Cardano.Crypto.Hash.Class
    Cardano.Crypto.Hash.Keccak256
    Cardano.Crypto.Hash.NeverUsed
    Cardano.Crypto.Hash.RIPEMD160
    Cardano.Crypto.Hash.SHA256
    Cardano.Crypto.Hash.SHA3_256
    Cardano.Crypto.Hash.SHA3_512
    Cardano.Crypto.Hash.SHA512
    Cardano.Crypto.Hash.Short
    Cardano.Crypto.Init
    Cardano.Crypto.KES
    Cardano.Crypto.KES.Class
    Cardano.Crypto.KES.CompactSingle
    Cardano.Crypto.KES.CompactSum
    Cardano.Crypto.KES.HashedSingle
    Cardano.Crypto.KES.Mock
    Cardano.Crypto.KES.NeverUsed
    Cardano.Crypto.KES.Padded
    Cardano.Crypto.KES.Simple
    Cardano.Crypto.KES.Single
    Cardano.Crypto.KES.Sum
    Cardano.Crypto.Libsodium
    Cardano.Crypto.Libsodium.C
    Cardano.Crypto.Libsodium.Constants
    Cardano.Crypto.Libsodium.Hash
    Cardano.Crypto.Libsodium.Hash.Class
    Cardano.Crypto.Libsodium.Init
    Cardano.Crypto.Libsodium.MLockedBytes
    Cardano.Crypto.Libsodium.MLockedBytes.Internal
    Cardano.Crypto.Libsodium.MLockedSeed
    Cardano.Crypto.Libsodium.Memory
    Cardano.Crypto.Libsodium.Memory.Internal
    Cardano.Crypto.Libsodium.UnsafeC
    Cardano.Crypto.MLDSA.C
    Cardano.Crypto.MLDSA.Constants
    Cardano.Crypto.PackedBytes
    Cardano.Crypto.PinnedSizedBytes
    Cardano.Crypto.SLHDSA.C
    Cardano.Crypto.SLHDSA.Constants
    Cardano.Crypto.Seed
    Cardano.Crypto.Util
    Cardano.Crypto.VRF
    Cardano.Crypto.VRF.Class
    Cardano.Crypto.VRF.Mock
    Cardano.Crypto.VRF.NeverUsed
    Cardano.Crypto.VRF.Simple
    Cardano.Crypto.XMSS.C
    Cardano.Crypto.XMSS.Constants
    Cardano.Foreign

  other-modules:
    Cardano.Crypto.PackedBytes.Internal

  build-depends:
    FailT,
    aeson,
    base16-bytestring >=1,
    bytestring,
    cardano-base >=0.1.6,
    cardano-binary >=1.9.1,
    cardano-strict-containers,
    crypton ^>=1.0,
    deepseq,
    heapwords,
    io-classes >=1.4.1,
    memory,
    memory-pool,
    mempack,
    mtl,
    nothunks,
    primitive >=0.8,
    template-haskell,
    text,
    th-compat,
    transformers,
    vector,

  if impl(ghc <9.0.0)
    build-depends:
      integer-gmp
  pkgconfig-depends:
    libblst >=0.3.14,
    libsodium,

  c-sources:
    cbits/blst_util.c
    cbits/cardano_mldsa44.c
    cbits/mldsa-native/mldsa_native.c
    cbits/cardano_falcon512.c
    cbits/falcon-padded-512/common/fips202.c
    cbits/cardano_slhdsa_bb6.c
    cbits/cardano_xmss_mock.c
    cbits/xmss-compat/cardano_sha256_fast.c
    cbits/xmss-reference/hash.c
    cbits/xmss-reference/hash_address.c
    cbits/xmss-reference/params.c
    cbits/xmss-reference/utils.c
    cbits/xmss-reference/wots.c
    cbits/xmss-reference/xmss_commons.c
    cbits/xmss-reference/xmss_core_fast.c

  -- cbits/xmss-compat supplies <openssl/sha.h> over libsodium for
  -- xmss-reference/hash.c; its SHAKE calls resolve to
  -- falcon-padded-512/common/fips202.c, so xmss-reference/fips202.c is not
  -- compiled, and randombytes() comes from cbits/cardano_xmss_mock.c.
  include-dirs:
    cbits
    cbits/mldsa-native
    cbits/falcon-padded-512/common
    cbits/xmss-compat
    cbits/xmss-reference

  -- mldsa-native (cbits/mldsa-native) is built as a single compilation unit
  -- for ML-DSA-44 only, with the randomized API disabled so that it needs no
  -- RNG. -O3 matches the flags mldsa-native benchmarks itself with.
  -- SLH-DSA bb-6: the SPHINCS+ reference (portable, ref/) or its 8-way
  -- AVX2 SHA-256 variant (sha2-avx2/), both with the parameter header
  -- params/params-cardano-bb6.h selected by PARAMS. sign.c and
  -- randombytes.c are left out: cbits/cardano_slhdsa_bb6.c provides
  -- seed-derived key generation and deterministic signing.
  if flag(pq-native-backends)
    c-sources:
      cbits/sphincsplus-sha2-avx2/address.c
      cbits/sphincsplus-sha2-avx2/fors.c
      cbits/sphincsplus-sha2-avx2/hash_sha2.c
      cbits/sphincsplus-sha2-avx2/hash_sha2x8.c
      cbits/sphincsplus-sha2-avx2/merkle.c
      cbits/sphincsplus-sha2-avx2/sha2.c
      cbits/sphincsplus-sha2-avx2/sha256avx.c
      cbits/sphincsplus-sha2-avx2/sha256x8.c
      cbits/sphincsplus-sha2-avx2/sha512x4.c
      cbits/sphincsplus-sha2-avx2/thash_sha2_simple.c
      cbits/sphincsplus-sha2-avx2/thash_sha2_simplex8.c
      cbits/sphincsplus-sha2-avx2/utils.c
      cbits/sphincsplus-sha2-avx2/utilsx8.c
      cbits/sphincsplus-sha2-avx2/wots.c

    include-dirs: cbits/sphincsplus-sha2-avx2
    cc-options: -DCARDANO_SLHDSA_AVX2
  else
    c-sources:
      cbits/sphincsplus-ref/address.c
      cbits/sphincsplus-ref/fors.c
      cbits/sphincsplus-ref/hash_sha2.c
      cbits/sphincsplus-ref/merkle.c
      cbits/sphincsplus-ref/sha2.c
      cbits/sphincsplus-ref/thash_sha2_simple.c
      cbits/sphincsplus-ref/utils.c
      cbits/sphincsplus-ref/utilsx1.c
      cbits/sphincsplus-ref/wots.c
      cbits/sphincsplus-ref/wotsx1.c

    include-dirs: cbits/sphincsplus-ref

  cc-options:
    -O3
    -DMLD_CONFIG_PARAMETER_SET=44
    -DMLD_CONFIG_NAMESPACE_PREFIX=cardano_mld
    -DMLD_CONFIG_NO_RANDOMIZED_API
    -DPARAMS=cardano-bb6

  -- Falcon-512: PQClean falcon-padded-512, portable (clean) or AVX2 build.
  -- pqclean.c is left out on purpose: it needs PQClean's randombytes, and
  -- cbits/cardano_falcon512.c provides seed-derived replacements.
  if flag(pq-native-backends)
    c-sources:
      cbits/falcon-padded-512/avx2/codec.c
      cbits/falcon-padded-512/avx2/common.c
      cbits/falcon-padded-512/avx2/fft.c
      cbits/falcon-padded-512/avx2/fpr.c
      cbits/falcon-padded-512/avx2/keygen.c
      cbits/falcon-padded-512/avx2/rng.c
      cbits/falcon-padded-512/avx2/sign.c
      cbits/falcon-padded-512/avx2/vrfy.c

    include-dirs: cbits/falcon-padded-512/avx2
    cc-options: -DCARDANO_FALCON512_AVX2
  else
    c-sources:
      cbits/falcon-padded-512/clean/codec.c
      cbits/falcon-padded-512/clean/common.c
      cbits/falcon-padded-512/clean/fft.c
      cbits/falcon-padded-512/clean/fpr.c
      cbits/falcon-padded-512/clean/keygen.c
      cbits/falcon-padded-512/clean/rng.c
      cbits/falcon-padded-512/clean/sign.c
      cbits/falcon-padded-512/clean/vrfy.c

    include-dirs: cbits/falcon-padded-512/clean

  if flag(pq-native-backends)
    cc-options:
      -DMLD_CONFIG_USE_NATIVE_BACKEND_ARITH
      -DMLD_CONFIG_USE_NATIVE_BACKEND_FIPS202

    asm-sources: cbits/mldsa-native/mldsa_native_asm.S
    asm-options:
      -Icbits/mldsa-native
      -DMLD_CONFIG_PARAMETER_SET=44
      -DMLD_CONFIG_NAMESPACE_PREFIX=cardano_mld
      -DMLD_CONFIG_NO_RANDOMIZED_API
      -DMLD_CONFIG_USE_NATIVE_BACKEND_ARITH
      -DMLD_CONFIG_USE_NATIVE_BACKEND_FIPS202

    if arch(x86_64)
      -- SHA-NI is chosen at run time (see cbits/xmss-compat), so no -msha.
      -- CARDANO_XMSS_MIDSTATE caches the PRF prefix block in the XMSS
      -- reference (cbits/xmss-reference/hash.c).
      cc-options: -mavx2 -mbmi2 -mfma -DCARDANO_XMSS_SHANI -DCARDANO_XMSS_MIDSTATE
      asm-options: -mavx2 -mbmi2

  if flag(secp256k1-support)
    exposed-modules:
      Cardano.Crypto.DSIGN.EcdsaSecp256k1
      Cardano.Crypto.DSIGN.SchnorrSecp256k1
      Cardano.Crypto.SECP256K1.C
      Cardano.Crypto.SECP256K1.Constants

    pkgconfig-depends: libsecp256k1
    cpp-options: -DSECP256K1_ENABLED

library testlib
  import: base, project-config
  hs-source-dirs: testlib
  visibility: public
  exposed-modules:
    Test.Crypto.AllocLog
    Test.Crypto.DSIGN
    Test.Crypto.EllipticCurve
    Test.Crypto.EqST
    Test.Crypto.Hash
    Test.Crypto.Instances
    Test.Crypto.KES
    Test.Crypto.PackedBytes
    Test.Crypto.Regressions
    Test.Crypto.RunIO
    Test.Crypto.Util
    Test.Crypto.Vector.SerializationUtils

  other-modules: Paths_cardano_crypto_class
  autogen-modules: Paths_cardano_crypto_class
  build-depends:
    FailT,
    HUnit,
    QuickCheck,
    base,
    base16-bytestring,
    bytestring >=0.10.12.0,
    cardano-base:testlib >=0.1.4,
    cardano-binary,
    cardano-crypto-class,
    cborg,
    containers,
    contra-tracer ^>=0.2.1,
    crypton,
    formatting,
    hspec,
    io-classes >=1.4.0,
    mempack,
    mtl,
    nothunks,
    pretty-show,
    quickcheck-instances,
    reflection,
    vector,

  if flag(stateful-mock-tests)
    cpp-options: -DSTATEFUL_MOCK_TESTS

  if flag(secp256k1-support)
    cpp-options: -DSECP256K1_ENABLED
    exposed-modules:
      Test.Crypto.Vector.Secp256k1DSIGN
      Test.Crypto.Vector.StringConstants
      Test.Crypto.Vector.Vectors

library benchlib
  import: base, project-config
  hs-source-dirs: benchlib
  visibility: public
  exposed-modules: Bench.Crypto.BenchData
  build-depends:
    base,
    bytestring,
    cardano-crypto-class,
    deepseq,

test-suite tests
  import: base, project-config
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  other-modules: Paths_cardano_crypto_class
  autogen-modules: Paths_cardano_crypto_class
  main-is: Main.hs
  build-depends:
    QuickCheck,
    base,
    bytestring,
    cardano-base:testlib >=0.1.3,
    cardano-crypto-class:{cardano-crypto-class, testlib},
    hspec,

  other-modules:
    Test.Cardano.Crypto.PackedBytes.Spec

  if flag(stateful-mock-tests)
    cpp-options: -DSTATEFUL_MOCK_TESTS

  if flag(secp256k1-support)
    cpp-options: -DSECP256K1_ENABLED
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N

benchmark bench
  import: base, project-config
  type: exitcode-stdio-1.0
  hs-source-dirs: bench
  main-is: Main.hs
  other-modules:
    Bench.Crypto.DSIGN
    Bench.Crypto.HASH
    Bench.Crypto.KES

  build-depends:
    base,
    bytestring,
    cardano-binary,
    cardano-crypto-class:{cardano-crypto-class, benchlib},
    criterion,
    deepseq,

  if flag(secp256k1-support)
    cpp-options: -DSECP256K1_ENABLED
  ghc-options: -threaded

test-suite test-memory-example
  import: base, project-config
  -- Temporarily removing this as it is breaking the CI, and
  -- we don't see the benefit. Will circle back to this to decide
  -- whether to modify or completely remove.
  buildable: False
  type: exitcode-stdio-1.0
  hs-source-dirs: memory-example
  main-is: Main.hs
  build-depends:
    base,
    bytestring,
    cardano-crypto-class,

  if (os(linux) || os(osx))
    build-depends: unix
